APP_ENV=development
APP_HOST=127.0.0.1
APP_PORT=3000
# FRONTEND_DIST enables React serving from the same Gin origin (requires a Vite build).
# Build React and copy its dist/ directory into web/dist/ first.
# FRONTEND_DIST=./web/dist
GIN_MODE=release
DB_PATH=./data/mail-manager.db

# Generate with: openssl rand -hex 32 (unique per deployment; do not commit)
JWT_SECRET=
JWT_ISSUER=mail-manager
JWT_TOKEN_TTL=15m

# Encrypted IMAP credentials are configured with POST /api/mail/settings.
# Generate a separate key: openssl rand -hex 32
MAIL_SETTINGS_KEY=

LLM_BASE_URL=http://127.0.0.1:8080/v1
LLM_MODEL=qwen3-4b
LLM_API_KEY=local
LLM_TIMEOUT=120s
LLM_TEMPERATURE=0
LLM_MAX_TOKENS=192
LLM_MAX_CONCURRENCY=1
CLASSIFIER_MAX_EMAIL_CHARS=2500
CLASSIFIER_INCLUDE_SPAM_IN_REPORT=false
