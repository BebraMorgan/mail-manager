APP_ENV=development
APP_HOST=127.0.0.1
APP_PORT=3000
GIN_MODE=release
DB_PATH=./data/mail-manager.db

# Generate with: openssl rand -hex 32 (unique per deployment; do not commit)
JWT_SECRET=
JWT_ISSUER=mail-manager
JWT_TOKEN_TTL=12h

MAIL_HOST=imap.yandex.ru
MAIL_PORT=993
MAIL_USERNAME=
MAIL_AUTH_METHOD=oauth2
MAIL_OAUTH_TOKEN=
MAIL_APP_PASSWORD=
MAIL_FOLDER=INBOX
# Opt-in only; specify the actual IMAP trash folder name
MAIL_ALLOW_DELETE=false
MAIL_TRASH_FOLDER=
MAIL_POLL_INTERVAL=5m
MAIL_FETCH_LIMIT=30
MAIL_MAX_MESSAGE_BYTES=1048576

LLM_BASE_URL=http://127.0.0.1:8080/v1
LLM_MODEL=qwen3-4b
LLM_API_KEY=local
LLM_TIMEOUT=120s
LLM_TEMPERATURE=0
LLM_MAX_TOKENS=192
LLM_MAX_CONCURRENCY=1
CLASSIFIER_MAX_EMAIL_CHARS=2500
CLASSIFIER_INCLUDE_SPAM_IN_REPORT=false
