# Application
APP_ENV=development
APP_HOST=127.0.0.1
APP_PORT=3000
GIN_MODE=debug

# Database
DB_PATH=./data/mail-manager.db

# Yandex Mail (IMAP)
MAIL_HOST=imap.yandex.ru
MAIL_PORT=993
MAIL_USERNAME=
MAIL_AUTH_METHOD=oauth2
MAIL_OAUTH_TOKEN=
MAIL_APP_PASSWORD=
MAIL_FOLDER=INBOX
MAIL_POLL_INTERVAL=5m

# Local LLM - llama.cpp
LLM_BASE_URL=http://127.0.0.1:8080/v1
LLM_MODEL=qwen3-4b
LLM_API_KEY=local
LLM_TIMEOUT=120s
LLM_TEMPERATURE=0
LLM_MAX_TOKENS=192
LLM_MAX_CONCURRENCY=1

# Classification
CLASSIFIER_MAX_EMAIL_CHARS=6000
CLASSIFIER_INCLUDE_SPAM_IN_REPORT=false
